    "end": 6.9362,
    "text": "紫外光下，微量物证，正在显影。",
    "source_duration": 2.636208,
    "tempo": 1
  },
  {
    "id": "path",
    "start": 8.3,
    "end": 11.3008,
    "text": "指纹回路，弹道膛线。重建轨迹。",
    "source_duration": 3.000792,
    "tempo": 1
  },
  {
    "id": "exchange",
    "start": 12.7,
    "end": 15.746,
    "text": "洛卡德交换定律。接触，留下痕迹。",
    "source_duration": 3.046,
    "tempo": 1
  },
  {
    "id": "profile",
    "start": 17.2,
    "end": 20.2043,
    "text": "行为侧写，动机解构。连接线索。",
    "source_duration": 3.004292,
    "tempo": 1
  },
  {
    "id": "outline",
